{
  "name": "bikespot",
  "version": "0.3.0",
  "description": "Save and reopen the bike spot you last used.",
  "license": "MIT",
  "author": "Simon van Lierde <code@duinlab.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonvanlierde/bikespot.git"
  },
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "budget": "node scripts/checkBundleBudget.mjs",
    "build": "tsc && vite build && node scripts/checkPrecache.mjs",
    "check": "biome check && knip",
    "coverage": "vitest run --coverage --coverage.reporter=text",
    "deploy": "pnpm run build && wrangler pages deploy",
    "dev": "vite",
    "fix": "biome check --write",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:setup": "playwright install chromium --only-shell",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "knip": {
    "ignoreDependencies": [
      "@j178/prek",
      "@fontsource-variable/overpass",
      "@fontsource-variable/overpass-mono"
    ]
  },
  "dependencies": {
    "@fontsource-variable/overpass": "^5.3.0",
    "@fontsource-variable/overpass-mono": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "lucide-preact": "1.59.0",
    "preact": "^11.0.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@j178/prek": "^0.5.6",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "knip": "^6.42.0",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.151.2"
  }
}
