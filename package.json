{
  "name": "bikespot",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "lint": "biome check .",
    "format": "biome check . --write",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "check": "pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "pnpm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "^5.3.0",
    "@fontsource-variable/overpass-mono": "^5.3.0",
    "@preact/signals": "^2.11.1",
    "lucide-preact": "1.31.0",
    "preact": "^10.29.8",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.123.0"
  }
}
