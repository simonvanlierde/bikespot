{
  "name": "bikespot",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "lint": "biome check .",
    "format": "biome check . --write",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && node scripts/writeCspHeaders.mjs && node scripts/checkCspHeaders.mjs && node scripts/checkPrecache.mjs",
    "check": "pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:setup": "playwright install chromium --only-shell",
    "deploy": "pnpm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "^5.3.0",
    "@fontsource-variable/overpass-mono": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "lucide-preact": "1.55.0",
    "preact": "^11.0.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "lefthook": "^2.2.1",
    "playwright": "1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.149.0"
  }
}
