// CI deploys the checked build as static assets to production and pull request Workers.
// public/_headers sets the response headers. Pages keeps its existing Git integration
// until the verified Worker's custom domain replaces it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bikespot",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "preview_urls": false,
  "workers_dev": true
}
