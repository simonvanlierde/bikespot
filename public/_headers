# Cloudflare Pages response headers. Spots, coordinates and photos stay in this
# origin's storage and the app fetches nothing but its own files, so keep the
# page unframeable and the network surface closed. Photos render from blob: URLs.
# The script-src placeholder is replaced at build time by
# scripts/writeCspHeaders.mjs with the sha256 of the inline theme script.
# Cloudflare already sends nosniff and this referrer policy by default; they are
# repeated here so every header the site relies on is declared in one place.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __INLINE_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(), geolocation=(self), payment=()
