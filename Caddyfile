:80 {
	root * /srv
	encode gzip zstd

	# SPA fallback: serve index.html for client-side navigation.
	try_files {path} /index.html
	file_server

	# The service worker must always revalidate so updates ship promptly.
	@sw path /sw.js
	header @sw Cache-Control "no-cache"

	# Hashed build assets are immutable and safe to cache aggressively.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
